{
  "edges": [
    {
      "to": "start-run",
      "from": "gate-check"
    },
    {
      "to": "fetch-lead",
      "from": "start-run"
    },
    {
      "to": "check-lead",
      "from": "fetch-lead"
    },
    {
      "to": "brand-profile",
      "from": "check-lead",
      "condition": "results['fetch-lead'].found == true"
    },
    {
      "to": "end-run-no-lead",
      "from": "check-lead",
      "condition": "results['fetch-lead'].found == false"
    },
    {
      "to": "brand-extract-fields",
      "from": "brand-profile"
    },
    {
      "to": "email-send",
      "from": "email-generate"
    },
    {
      "to": "end-run",
      "from": "email-send"
    },
    {
      "to": "writer-pick",
      "from": "brand-extract-fields"
    },
    {
      "to": "writer-plan",
      "from": "writer-pick"
    },
    {
      "to": "template-head",
      "from": "writer-plan"
    },
    {
      "to": "email-generate",
      "from": "template-head"
    }
  ],
  "nodes": [
    {
      "id": "gate-check",
      "type": "http.call",
      "config": {
        "path": "/gate-check",
        "method": "POST",
        "service": "campaign",
        "stopAfterIf": "result.allowed == false"
      }
    },
    {
      "id": "start-run",
      "type": "http.call",
      "config": {
        "path": "/start-run",
        "method": "POST",
        "service": "campaign"
      }
    },
    {
      "id": "fetch-lead",
      "type": "http.call",
      "config": {
        "path": "/orgs/buffer/next",
        "method": "POST",
        "service": "lead"
      },
      "retries": 0
    },
    {
      "id": "check-lead",
      "type": "condition"
    },
    {
      "id": "brand-profile",
      "type": "http.call",
      "config": {
        "path": "/internal/brands/{id}",
        "method": "GET",
        "service": "brand"
      },
      "inputMapping": {
        "params.id": "$ref:start-run.output.brandIds[0]"
      }
    },
    {
      "id": "brand-extract-fields",
      "type": "http.call",
      "config": {
        "body": {
          "fields": [
            {
              "key": "companyOverview",
              "description": "A comprehensive overview of the company"
            },
            {
              "key": "valueProposition",
              "description": "The company's core value proposition"
            },
            {
              "key": "keyFeatures",
              "description": "Key features of the company's product or service"
            },
            {
              "key": "targetAudience",
              "description": "The company's target audience"
            },
            {
              "key": "customerPainPoints",
              "description": "Pain points the company solves for customers"
            },
            {
              "key": "competitors",
              "description": "The company's main competitors"
            },
            {
              "key": "productDifferentiators",
              "description": "What differentiates the product from competitors"
            },
            {
              "key": "socialProof",
              "description": "Social proof such as testimonials, case studies, or notable clients"
            },
            {
              "key": "callToAction",
              "description": "The company's primary call to action"
            },
            {
              "key": "urgency",
              "description": "Any urgency or time-sensitive elements"
            },
            {
              "key": "scarcity",
              "description": "Any scarcity or limited availability elements"
            },
            {
              "key": "riskReversal",
              "description": "Guarantees or risk reversal offers"
            },
            {
              "key": "valueStacking",
              "description": "Value stacking or bundling strategies"
            },
            {
              "key": "priceAnchoring",
              "description": "Price anchoring or pricing strategies"
            },
            {
              "key": "leadership",
              "description": "Company leadership and key team members"
            },
            {
              "key": "funding",
              "description": "Funding information and investors"
            },
            {
              "key": "revenueMilestones",
              "description": "Revenue milestones and growth metrics"
            },
            {
              "key": "awardsAndRecognition",
              "description": "Awards, recognition, and press mentions"
            },
            {
              "key": "additionalContext",
              "description": "Any additional relevant context about the company"
            }
          ]
        },
        "path": "/orgs/brands/extract-fields",
        "method": "POST",
        "service": "brand"
      }
    },
    {
      "id": "writer-pick",
      "type": "http.call",
      "config": {
        "path": "/internal/writer-pick",
        "method": "GET",
        "service": "features"
      },
      "retries": 2,
      "inputMapping": {
        "query.campaignId": "$ref:flow_input.campaignId",
        "query.workflowSlug": "$ref:flow_input.workflowSlug"
      }
    },
    {
      "id": "writer-plan",
      "type": "script",
      "config": {
        "code": "export async function main(pick) {\n  const leg = pick && pick.legKey ? pick.legKey : \"unknown leg\";\n  const templateDynastySlug = pick && pick.template ? pick.template.templateDynastySlug : null;\n  const model = pick && pick.llm ? pick.llm.model : null;\n  if (typeof templateDynastySlug !== \"string\" || templateDynastySlug.length === 0) {\n    throw new Error(\"[writer-plan] no template to write with on \" + leg + \": \" + ((pick && pick.templateUnavailableReason) || \"features-service served none\") + \". Nothing is written.\");\n  }\n  if (typeof model !== \"string\" || model.length === 0) {\n    throw new Error(\"[writer-plan] no LLM to write with on \" + leg + \": \" + ((pick && pick.llmUnavailableReason) || \"features-service served none\") + \". Nothing is written.\");\n  }\n  const t = pick.template;\n  const l = pick.llm;\n  console.log(\"[writer-plan] \" + leg + (pick.strategyId ? \" (strategy \" + pick.strategyId + \")\" : \"\") +\n    \": template dynasty \" + templateDynastySlug + \" (place \" + t.place + \", \" + (t.isMature ? \"mature\" : \"learning\") + \", $\" + t.spentUsd + \" spent, \" + t.outcomes + \" outcomes)\" +\n    \", LLM \" + model + \" (place \" + l.place + \", \" + (l.isMature ? \"mature\" : \"learning\") + \", $\" + l.spentUsd + \" spent, \" + l.outcomes + \" outcomes)\");\n  return { templateDynastySlug, model, provider: l.provider ?? null, legKey: pick.legKey ?? null, strategyId: pick.strategyId ?? null };\n}"
      },
      "retries": 0,
      "inputMapping": {
        "pick": "$ref:writer-pick.output"
      }
    },
    {
      "id": "template-head",
      "type": "http.call",
      "config": {
        "path": "/internal/template-dynasties/{slug}/head",
        "method": "GET",
        "service": "content-generation"
      },
      "retries": 2,
      "inputMapping": {
        "params.slug": "$ref:writer-plan.output.templateDynastySlug"
      }
    },
    {
      "id": "email-generate",
      "type": "http.call",
      "config": {
        "body": {},
        "path": "/generate",
        "method": "POST",
        "service": "content-generation"
      },
      "retries": 0,
      "inputMapping": {
        "body.type": "$ref:template-head.output.template.type",
        "body.model": "$ref:writer-plan.output.model",
        "body.leadId": "$ref:fetch-lead.output.lead.leadId",
        "body.variables.leadCity": "$ref:fetch-lead.output.lead.data.city",
        "body.variables.leadState": "$ref:fetch-lead.output.lead.data.state",
        "body.variables.leadTitle": "$ref:fetch-lead.output.lead.data.currentTitle",
        "body.variables.clientName": "$ref:brand-profile.output.brand.name",
        "body.variables.leadCountry": "$ref:fetch-lead.output.lead.data.country",
        "body.variables.leadHeadline": "$ref:fetch-lead.output.lead.data.headline",
        "body.variables.leadLastName": "$ref:fetch-lead.output.lead.data.lastName",
        "body.variables.leadTimezone": "$ref:fetch-lead.output.lead.data.timezone",
        "body.variables.leadFirstName": "$ref:fetch-lead.output.lead.data.firstName",
        "body.variables.leadFunctions": "$ref:fetch-lead.output.lead.data.functions",
        "body.variables.leadSeniority": "$ref:fetch-lead.output.lead.data.seniority",
        "body.variables.leadCompanyCity": "$ref:fetch-lead.output.lead.data.organization.city",
        "body.variables.leadCompanyName": "$ref:fetch-lead.output.lead.data.organization.name",
        "body.variables.leadCompanySize": "$ref:fetch-lead.output.lead.data.organization.estimatedNumEmployees",
        "body.variables.leadDepartments": "$ref:fetch-lead.output.lead.data.departments",
        "body.variables.leadLinkedinUrl": "$ref:fetch-lead.output.lead.data.linkedinUrl",
        "body.variables.leadCompanyState": "$ref:fetch-lead.output.lead.data.organization.state",
        "body.variables.leadCompanyCountry": "$ref:fetch-lead.output.lead.data.organization.country",
        "body.variables.leadSubdepartments": "$ref:fetch-lead.output.lead.data.subdepartments",
        "body.variables.leadCompanyIndustry": "$ref:fetch-lead.output.lead.data.organization.industry",
        "body.variables.leadCompanyKeywords": "$ref:fetch-lead.output.lead.data.organization.keywords",
        "body.variables.brandExtractedFields": "$ref:brand-extract-fields.output",
        "body.variables.leadCompanyTechStack": "$ref:fetch-lead.output.lead.data.organization.technologyNames",
        "body.variables.leadBusinessLanguages": "$ref:fetch-lead.output.lead.data.businessLanguages",
        "body.variables.leadCompanyIndustries": "$ref:fetch-lead.output.lead.data.organization.industries",
        "body.variables.leadCompanyWebsiteUrl": "$ref:fetch-lead.output.lead.data.organization.websiteUrl",
        "body.variables.leadEmploymentHistory": "$ref:fetch-lead.output.lead.data.employmentHistory",
        "body.variables.leadCompanyDescription": "$ref:fetch-lead.output.lead.data.organization.shortDescription",
        "body.variables.leadCompanyFoundedYear": "$ref:fetch-lead.output.lead.data.organization.foundedYear",
        "body.variables.leadCompanyLinkedinUrl": "$ref:fetch-lead.output.lead.data.organization.linkedinUrl",
        "body.variables.leadCompanyFundingStage": "$ref:fetch-lead.output.lead.data.organization.latestFundingStage",
        "body.variables.leadCompanyTotalFunding": "$ref:fetch-lead.output.lead.data.organization.totalFunding",
        "body.variables.leadCompanyAnnualRevenue": "$ref:fetch-lead.output.lead.data.organization.annualRevenue",
        "body.variables.leadCompanyFundingEvents": "$ref:fetch-lead.output.lead.data.organization.fundingEvents",
        "body.variables.leadCompanySeoDescription": "$ref:fetch-lead.output.lead.data.organization.seoDescription",
        "body.variables.leadCompanySecondaryIndustries": "$ref:fetch-lead.output.lead.data.organization.secondaryIndustries",
        "body.variables.leadCompanyLatestFundingRoundDate": "$ref:fetch-lead.output.lead.data.organization.latestFundingRoundDate"
      }
    },
    {
      "id": "email-send",
      "type": "http.call",
      "config": {
        "body": {
          "tag": "sales-sequence-email",
          "type": "broadcast",
          "metadata": {
            "source": "mcpfactory-campaign-service"
          }
        },
        "path": "/orgs/send",
        "method": "POST",
        "service": "email-gateway",
        "validateResponse": {
          "field": "success",
          "equals": true
        }
      },
      "retries": 0,
      "inputMapping": {
        "body.to": "$ref:fetch-lead.output.lead.email",
        "body.leadId": "$ref:fetch-lead.output.lead.leadId",
        "body.subject": "$ref:email-generate.output.subject",
        "body.sequence": "$ref:email-generate.output.sequence",
        "body.timezone": "$ref:fetch-lead.output.lead.data.timezone",
        "body.campaignId": "$ref:flow_input.campaignId",
        "body.workflowSlug": "$ref:start-run.output.workflowSlug",
        "body.recipientCompany": "$ref:fetch-lead.output.lead.data.organization.name",
        "body.recipientLastName": "$ref:fetch-lead.output.lead.data.lastName",
        "body.recipientFirstName": "$ref:fetch-lead.output.lead.data.firstName",
        "body.metadata.emailGenerationId": "$ref:email-generate.output.id"
      }
    },
    {
      "id": "end-run",
      "type": "http.call",
      "config": {
        "body": {
          "success": true,
          "stopCampaign": false
        },
        "path": "/end-run",
        "method": "POST",
        "service": "campaign"
      },
      "retries": 0,
      "inputMapping": {
        "headers.x-org-id": "$ref:flow_input.orgId",
        "headers.x-run-id": "$ref:flow_input.runId",
        "headers.x-user-id": "$ref:flow_input.userId",
        "headers.x-campaign-id": "$ref:flow_input.campaignId",
        "headers.x-feature-slug": "$ref:flow_input.featureSlug",
        "headers.x-workflow-slug": "$ref:flow_input.workflowSlug"
      }
    },
    {
      "id": "end-run-no-lead",
      "type": "http.call",
      "config": {
        "body": {
          "success": true,
          "stopCampaign": true
        },
        "path": "/end-run",
        "method": "POST",
        "service": "campaign"
      },
      "retries": 0,
      "inputMapping": {
        "headers.x-org-id": "$ref:flow_input.orgId",
        "headers.x-run-id": "$ref:flow_input.runId",
        "headers.x-user-id": "$ref:flow_input.userId",
        "headers.x-campaign-id": "$ref:flow_input.campaignId",
        "headers.x-feature-slug": "$ref:flow_input.featureSlug",
        "headers.x-workflow-slug": "$ref:flow_input.workflowSlug"
      }
    },
    {
      "id": "end-run-error",
      "type": "http.call",
      "config": {
        "body": {
          "success": false,
          "stopCampaign": false
        },
        "path": "/end-run",
        "method": "POST",
        "service": "campaign"
      },
      "retries": 0,
      "inputMapping": {
        "headers.x-org-id": "$ref:flow_input.orgId",
        "headers.x-run-id": "$ref:flow_input.runId",
        "headers.x-user-id": "$ref:flow_input.userId",
        "headers.x-campaign-id": "$ref:flow_input.campaignId",
        "headers.x-feature-slug": "$ref:flow_input.featureSlug",
        "headers.x-workflow-slug": "$ref:flow_input.workflowSlug"
      }
    }
  ],
  "onError": "end-run-error"
}